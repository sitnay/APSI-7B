generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transaksi {
  id_transaksi      String      @id @db.VarChar(10)
  tanggal_transaksi DateTime?   @db.Date
  total_transaksi   Decimal?    @db.Decimal(10, 2)
  id_pembayaran     String?     @db.VarChar(10)
  pembayaran        pembayaran? @relation(fields: [id_pembayaran], references: [id_pembayaran], onDelete: NoAction, onUpdate: NoAction)
}

model bahan_baku {
  id_bahan        String            @id @db.VarChar(10)
  nama_bahan      String?           @db.VarChar(100)
  stok_saat_ini   Decimal?          @db.Decimal(10, 2)
  stok_minimum    Decimal?          @db.Decimal(10, 2)
  satuan          String?           @db.VarChar(20)
  komposisi_menu  komposisi_menu[]
  penggunaan_stok penggunaan_stok[]
}

model detail_pesanan {
  id_detail        String   @id @db.VarChar(10)
  kuantitas_produk Int?
  subtotal         Decimal? @db.Decimal(10, 2)
  id_pesanan       String?  @db.VarChar(10)
  id_menu          String?  @db.VarChar(10)
  menu             menu?    @relation(fields: [id_menu], references: [id_menu], onDelete: NoAction, onUpdate: NoAction)
  pesanan          pesanan? @relation(fields: [id_pesanan], references: [id_pesanan], onDelete: NoAction, onUpdate: NoAction)
}

model komposisi_menu {
  id_komposisi String      @id @db.VarChar(10)
  jumlah_bahan Decimal?    @db.Decimal(10, 2)
  id_menu      String?     @db.VarChar(10)
  id_bahan     String?     @db.VarChar(10)
  bahan_baku   bahan_baku? @relation(fields: [id_bahan], references: [id_bahan], onDelete: NoAction, onUpdate: NoAction)
  menu         menu?       @relation(fields: [id_menu], references: [id_menu], onDelete: NoAction, onUpdate: NoAction)
}

model laporan_penjualan {
  id_laporan      String    @id @db.VarChar(10)
  periode         String?   @db.VarChar(30)
  total_penjualan Decimal?  @db.Decimal(12, 2)
  id_pengguna     String?   @db.VarChar(10)
  pengguna        pengguna? @relation(fields: [id_pengguna], references: [id_pengguna], onDelete: NoAction, onUpdate: NoAction)
}

model menu {
  id_menu         String           @id @db.VarChar(10)
  nama_menu       String?          @db.VarChar(100)
  harga           Decimal?         @db.Decimal(10, 2)
  status_tersedia Int?
  detail_pesanan  detail_pesanan[]
  komposisi_menu  komposisi_menu[]
}

model pelanggan {
  id_pelanggan     String    @id @db.VarChar(10)
  nama_pelanggan   String?   @db.VarChar(100)
  alamat_pelanggan String?   @db.VarChar(255)
  no_hp_pelanggan  String?   @db.VarChar(15)
  pesanan          pesanan[]
}

model pembayaran {
  id_pembayaran     String      @id @db.VarChar(10)
  id_pesanan        String?     @db.VarChar(10)
  metode            String?     @db.VarChar(20)
  jumlah_bayar      Decimal?    @db.Decimal(10, 2)
  status_pembayaran String?     @db.VarChar(20)
  id_pengguna       String?     @db.VarChar(10)
  pengguna          pengguna?   @relation(fields: [id_pengguna], references: [id_pengguna], onDelete: NoAction, onUpdate: NoAction)
  pesanan           pesanan?    @relation(fields: [id_pesanan], references: [id_pesanan], onDelete: NoAction, onUpdate: NoAction)
  transaksi         transaksi[]
}

model pengguna {
  id_pengguna       String              @id @db.VarChar(10)
  nama              String?             @db.VarChar(100)
  username          String?             @db.VarChar(50)
  password          String?             @db.VarChar(255)
  role              String?             @db.VarChar(20)
  laporan_penjualan laporan_penjualan[]
  pembayaran        pembayaran[]
  penggunaan_stok   penggunaan_stok[]
  pesanan           pesanan[]
}

model penggunaan_stok {
  id_penggunaan  String      @id @db.VarChar(10)
  tanggal        DateTime?   @db.Date
  jumlah_dipakai Decimal?    @db.Decimal(10, 2)
  id_bahan       String?     @db.VarChar(10)
  id_pengguna    String?     @db.VarChar(10)
  bahan_baku     bahan_baku? @relation(fields: [id_bahan], references: [id_bahan], onDelete: NoAction, onUpdate: NoAction)
  pengguna       pengguna?   @relation(fields: [id_pengguna], references: [id_pengguna], onDelete: NoAction, onUpdate: NoAction)
}

model pesanan {
  id_pesanan     String           @id @db.VarChar(10)
  tanggal        DateTime?        @db.Date
  nomor_antrian  Int?
  status_pesanan String?          @db.VarChar(20)
  total_tagihan  Decimal?         @db.Decimal(10, 2)
  id_pengguna    String?          @db.VarChar(10)
  id_pelanggan   String?          @db.VarChar(10)
  detail_pesanan detail_pesanan[]
  pembayaran     pembayaran[]
  pelanggan      pelanggan?       @relation(fields: [id_pelanggan], references: [id_pelanggan], onDelete: NoAction, onUpdate: NoAction)
  pengguna       pengguna?        @relation(fields: [id_pengguna], references: [id_pengguna], onDelete: NoAction, onUpdate: NoAction)
}
